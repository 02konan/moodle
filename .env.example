# Copier en .env (local) ou saisir dans l'onglet « Environment » de Dokploy.

# Base de données
DB_NAME=moodle_signup
DB_USER=moodle_signup
DB_PASS=change-moi
DB_ROOT_PASS=change-moi-aussi
# DB_HOST=db   # imposé par docker-compose ; à renseigner hors Docker

# API référentiel (sections / cycles / niveaux / classes)
REFERENTIEL_API_URL=https://exemple.com/api-moodle.php
REFERENTIEL_CACHE_TTL=300

# Compte administrateur créé ou mis à jour au démarrage (optionnel, 10 caractères minimum)
ADMIN_EMAIL=
ADMIN_PASSWORD=
